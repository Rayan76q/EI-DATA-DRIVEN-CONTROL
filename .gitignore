# Local datasets and generated results; MATLAB source and Simulink models are versioned.
*.csv
/results/*
!/results/final/
!/results/final/**/*.csv

# Python/Jupyter runtime files.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Generated MATLAB/Simulink cache and build files.
*.asv
*.slxc
slprj/
*_grt_rtw/
simulink_cache/
simulink_codegen/
matlab_preferences/


# MATLAB exports and runtime files belong under results, outside source.
/src/**/*.mat
/src/**/*.onnx
